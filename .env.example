# ---- Admin auth ----
# Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=

# Admin account, auto-created on first login attempt after deploy
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_before_deploying

# ---- Database (Upstash Redis) ----
# These are auto-filled by Vercel when you add the "Upstash" integration
# from the Storage tab. For local dev, copy the REST URL/token from
# https://console.upstash.com into this file.
KV_REST_API_URL=
KV_REST_API_TOKEN=
